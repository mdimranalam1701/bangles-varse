PORT=5002
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bangelsverse
JWT_SECRET=replace_with_a_strong_64_char_random_secret

# Comma-separated allowed origins (leave empty in single-origin or dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Serve built Vite bundle from backend when true (unified deploy)
SERVE_FRONTEND=true

# Cloudinary (optional: falls back to local /uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional in dev; required for live online UPI/card payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Store WhatsApp & Support Phone (displayed for 1-tap assisted ordering)
SUPPORT_PHONE=9876543210
SUPPORT_WHATSAPP=919876543210

