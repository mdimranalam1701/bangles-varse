{
  "name": "bangels-verse",
  "version": "2.0.0",
  "private": true,
  "description": "Bangels Verse — Handcrafted Bangles Marketplace (Full-Stack Production)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mongo": "node -e \"const fs=require('fs'),cp=require('child_process');fs.mkdirSync('.mongodb-data',{recursive:true});cp.spawn('C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe',['--dbpath','.mongodb-data','--port','27017','--bind_ip','127.0.0.1'],{stdio:'inherit'})\"",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test"
  }
}

